{
  "private": true,
  "name": "@tractor-store-vertical-demo/explore",
  "version": "0.1.0",
  "scripts": {
    "dev": "modern dev",
    "build": "modern build && ultramodern-create ultramodern public-surface --app explore --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && ultramodern-create ultramodern public-surface --app explore --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && ultramodern-create ultramodern cloudflare-output-verify --app explore",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app explore",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "deploy": "modern deploy"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "explore",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect-bff"
  },
  "zephyr:dependencies": {},
  "dependencies": {
    "@module-federation/bridge-react": "npm:@bleedingdev/mf-bridge-react@2.9.1",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.1",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.1",
    "@tanstack/react-router": "1.170.35",
    "@tractor-store-vertical-demo/shared-contracts": "workspace:*",
    "@tractor-store-vertical-demo/shared-design-tokens": "workspace:*",
    "i18next": "26.4.2",
    "node-fetch": "^3.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "effect": "4.0.0-rc.117",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.116.0",
    "zephyr-rspack-plugin": "1.2.4",
    "cross-env": "10.1.0",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/app-tools": "catalog:ultramodern"
  },
  "exports": {
    "./Footer": "./src/components/footer.tsx",
    "./Header": "./src/components/header.tsx",
    "./HomePage": "./src/components/home-page.tsx",
    "./ProductGrid": "./src/components/product-grid.tsx",
    "./Recommendations": "./src/components/recommendations.tsx",
    "./Route": "./src/federation-entry.tsx",
    "./StorePicker": "./src/components/store-picker.tsx",
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/explore-client.ts"
  }
}
