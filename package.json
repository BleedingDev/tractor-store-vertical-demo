{
  "private": true,
  "name": "tractor-store-vertical-demo",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @tractor-store-vertical-demo/shell-super-app --filter @tractor-store-vertical-demo/explore --filter @tractor-store-vertical-demo/decide --filter @tractor-store-vertical-demo/checkout dev",
    "dev:shell": "pnpm --filter @tractor-store-vertical-demo/shell-super-app dev",
    "dev:explore": "pnpm --filter @tractor-store-vertical-demo/explore dev",
    "dev:decide": "pnpm --filter @tractor-store-vertical-demo/decide dev",
    "dev:checkout": "pnpm --filter @tractor-store-vertical-demo/checkout dev",
    "build": "ultramodern-create ultramodern typecheck --build packages/shared-contracts/tsconfig.json && ultramodern-create ultramodern typecheck --build packages/shared-design-tokens/tsconfig.json && ultramodern-create ultramodern typecheck --emit --project verticals/explore/tsconfig.json --skipLibCheck && ultramodern-create ultramodern typecheck --emit --project verticals/checkout/tsconfig.json --skipLibCheck && pnpm -r --filter \"./verticals/*\" run build && pnpm --filter \"./apps/shell-super-app\" run build && pnpm mf:types && pnpm performance:readiness",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint apps verticals packages",
    "lint:fix": "oxlint apps verticals packages --fix",
    "typecheck": "ultramodern-create ultramodern typecheck --build tsconfig.json",
    "cloudflare:build": "ultramodern-create ultramodern typecheck --build packages/shared-contracts/tsconfig.json && ultramodern-create ultramodern typecheck --build packages/shared-design-tokens/tsconfig.json && ultramodern-create ultramodern typecheck --emit --project verticals/explore/tsconfig.json --skipLibCheck && ultramodern-create ultramodern typecheck --emit --project verticals/checkout/tsconfig.json --skipLibCheck && pnpm -r --filter \"./verticals/*\" run cloudflare:build && pnpm --filter \"./apps/shell-super-app\" run cloudflare:build && pnpm mf:types --target cloudflare && pnpm cloudflare-output:verify && pnpm cloudflare:ssr-proof",
    "cloudflare:deploy": "pnpm -r --filter \"./verticals/*\" run cloudflare:deploy && pnpm --filter \"./apps/shell-super-app\" run cloudflare:deploy",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --out .codex/reports/cloudflare-version-proof/public-url-proof.json",
    "node:proof": "ultramodern-create ultramodern backend-federation-proof",
    "proof:workflow": "node ./scripts/proof-public-workflow.mjs",
    "test:e2e": "pnpm proof:workflow",
    "test:e2e:headed": "pnpm proof:workflow --headed",
    "skills:install": "ultramodern-create ultramodern skills install",
    "skills:check": "ultramodern-create ultramodern skills check",
    "agents:refs:install": "node ./scripts/setup-agent-reference-repos.mts",
    "agents:refs:check": "node ./scripts/setup-agent-reference-repos.mts --check",
    "postinstall": "ultramodern-create ultramodern skills install --postinstall",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm skills:check && pnpm i18n:boundaries && pnpm api:check:files && pnpm contract:check && pnpm performance:readiness",
    "mf:types": "ultramodern-create ultramodern mf-types",
    "performance:readiness": "ultramodern-create ultramodern performance-readiness",
    "contract:check": "ultramodern-create ultramodern validate",
    "i18n:boundaries": "node ./scripts/check-ultramodern-i18n-boundaries.mts",
    "api:check": "modern-api-check",
    "zerops:materialize": "ultramodern-create ultramodern zerops-materialize",
    "cloudflare-output:verify": "ultramodern-create ultramodern cloudflare-output-verify",
    "node:backend-federation:generate": "ultramodern-create ultramodern backend-federation-generate",
    "cloudflare:ssr-proof": "ultramodern-create ultramodern cloudflare-ssr-proof",
    "api:check:files": "modern-api-check-files"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "verticals/*",
    "packages/*"
  ],
  "modernjs": {
    "preset": "presetUltramodern",
    "workspace": "ultramodern-superapp",
    "topology": "./topology/reference-topology.json",
    "ownership": "./topology/ownership.json"
  },
  "devDependencies": {
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/tsgo": "0.41.0",
    "@playwright/test": "^1.60.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "effect": "4.0.0-rc.117",
    "lefthook": "^2.1.10",
    "miniflare": "5.20260921.0-alpha",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "ultracite": "7.11.0",
    "wrangler": "4.137.0",
    "zephyr-agent": "1.2.4",
    "cross-env": "10.1.0",
    "@types/node": "^26.4.1",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/code-tools": "catalog:ultramodern",
    "@modern-js/ultramodern-create": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern"
  },
  "dependencies": {}
}
